{
  "name": "yak-ops-website-ui-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Yak Ops website frontend workspace",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "vite build --config apps/web/vite.config.ts",
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "start": "npm run dev",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "biome:lint": "biome lint .",
    "format": "biome format --write .",
    "lint": "npm run biome:lint && npm run tsc",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@types/node": "^24.0.10",
    "@types/react": "^18.2.12",
    "@types/react-dom": "^18.2.7",
    "less": "^4.2.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

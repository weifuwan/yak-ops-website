{
  "name": "yak-ops-website-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Yak Ops website frontend",
  "scripts": {
    "build": "max build",
    "dev": "max dev",
    "start": "cross-env REACT_APP_ENV=dev max dev",
    "postinstall": "max setup",
    "biome:lint": "biome lint .",
    "format": "biome format --write .",
    "lint": "npm run biome:lint && npm run tsc",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.25.4",
    "antd-style": "^3.7.0",
    "framer-motion": "^12.38.0",
    "github-slugger": "^2.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@types/node": "^24.0.10",
    "@types/react": "^18.2.12",
    "@types/react-dom": "^18.2.7",
    "@umijs/max": "^4.3.24",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

{
  "compilerOptions": {
    "baseUrl": "./",
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./apps/web/*"
      ],
      "@yak-ops-website/yak-ui": [
        "./packages/yak-ui/src/index.ts"
      ]
    }
  },
  "include": [
    "./apps/**/*.d.ts",
    "./apps/**/*.ts",
    "./apps/**/*.tsx",
    "./packages/**/*.ts",
    "./packages/**/*.tsx"
  ]
}

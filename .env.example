SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/yak_ops_website?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=yakops

WEBSITE_PUBLIC_BASE_URL=http://localhost:8000
WEBSITE_SESSION_TTL=30m
WEBSITE_SESSION_COOKIE_NAME=yakops_web_session
WEBSITE_SESSION_COOKIE_SECURE=false

WEBSITE_MAIL_MODE=log
WEBSITE_MAIL_FROM=no-reply@yakops.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SSL=false
MAIL_STARTTLS=false

